# Local development credentials only. Docker services use their own internal ports.
POSTGRES_USER=rounds
POSTGRES_PASSWORD=rounds
POSTGRES_DB=rounds
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
SOURCE_PORT=4002
LLM_PORT=4001
# Internal Docker URLs; change these to use external services.
SOURCE_BASE_URL=http://listing-source:4002
LLM_BASE_URL=http://mock-llm:4001/v1
POLL_INTERVAL_MS=900000
SOURCE_REQUESTS_PER_SECOND=5
SOURCE_CONCURRENCY=10
SOURCE_TIMEOUT_MS=10000
LLM_MODEL=mock-llm
LLM_API_KEY=mock
LLM_TIMEOUT_MS=15000
LLM_CONCURRENCY=2
LLM_DAILY_CAP=2000
LLM_MAX_ATTEMPTS=3
RETENTION_DAYS=90
WORKER_ENABLED=true
